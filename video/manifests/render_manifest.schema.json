{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bradleylab/tanager-rocks/video/manifests/render_manifest.schema.json",
  "title": "Tanager Rocks video render manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "generated_at_utc",
    "release",
    "render",
    "source_files",
    "inputs",
    "generation_evidence",
    "media_masters",
    "outputs",
    "environment",
    "qc",
    "rights"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "tanager-rocks-video-render-manifest"},
    "status": {"const": "automated_qc_passed_pending_human_review"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source_commit",
        "source_tag",
        "source_dirty",
        "repository_url",
        "archive_doi",
        "output_basename",
        "bundle_name",
        "contract_locator"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tag": {"$ref": "#/$defs/exact_tag"},
        "source_dirty": {"const": false},
        "repository_url": {"type": "string", "pattern": "^https://"},
        "archive_doi": {
          "type": "string",
          "pattern": "^https://doi\\.org/10\\.5281/zenodo\\.[1-9][0-9]*$"
        },
        "output_basename": {"const": "tanager-rocks-video"},
        "bundle_name": {"type": "string", "pattern": "^tanager-rocks-video-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "contract_locator": {"const": "video/manifests/release_contract.json"}
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "contract_locator",
        "contract_sha256",
        "settings",
        "selected_tiers",
        "selected_sources",
        "workspace_isolation",
        "generated_artifacts"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "selected_tiers": {
                "required": ["03"],
                "properties": {"03": {"const": "upgrade"}}
              }
            }
          },
          "then": {
            "properties": {
              "selected_sources": {
                "properties": {"03": {"$ref": "#/$defs/source_03_upgrade"}}
              },
              "generated_artifacts": {
                "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/clip_03_upgrade"}]
              }
            }
          },
          "else": {
            "properties": {
              "selected_sources": {
                "properties": {"03": {"$ref": "#/$defs/source_fallback"}}
              },
              "generated_artifacts": {
                "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/clip_03_fallback"}]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selected_tiers": {
                "required": ["04"],
                "properties": {"04": {"const": "upgrade"}}
              }
            }
          },
          "then": {
            "properties": {
              "selected_sources": {
                "properties": {"04": {"$ref": "#/$defs/source_04_upgrade"}}
              },
              "generated_artifacts": {
                "prefixItems": [{}, {}, {}, {}, {"$ref": "#/$defs/clip_04_upgrade"}]
              }
            }
          },
          "else": {
            "properties": {
              "selected_sources": {
                "properties": {"04": {"$ref": "#/$defs/source_fallback"}}
              },
              "generated_artifacts": {
                "prefixItems": [{}, {}, {}, {}, {"$ref": "#/$defs/clip_04_fallback"}]
              }
            }
          }
        }
      ],
      "properties": {
        "command": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}},
        "contract_locator": {"const": "video/manifests/release_contract.json"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "fps",
            "pixel_format",
            "video_encoder_args",
            "dissolve_seconds",
            "audio_codec",
            "audio_bitrate"
          ],
          "properties": {
            "width": {"const": 1920},
            "height": {"const": 1080},
            "fps": {"const": 30},
            "pixel_format": {"const": "yuv420p"},
            "video_encoder_args": {
              "const": ["-c:v", "libx264", "-preset", "medium", "-crf", "18", "-pix_fmt", "yuv420p"]
            },
            "dissolve_seconds": {"const": 0.33},
            "audio_codec": {"const": "aac"},
            "audio_bitrate": {"const": "192k"}
          }
        },
        "selected_tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["00", "01", "02", "03", "04", "05", "06a", "06b", "07", "08"],
          "properties": {
            "00": {"const": "designed"},
            "01": {"const": "designed"},
            "02": {"const": "designed"},
            "03": {"enum": ["upgrade", "fallback"]},
            "04": {"enum": ["upgrade", "fallback"]},
            "05": {"const": "tanager-still"},
            "06a": {"const": "designed"},
            "06b": {"const": "fallback"},
            "07": {"const": "tanager-still"},
            "08": {"const": "designed"}
          }
        },
        "selected_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["00", "01", "02", "03", "04", "05", "06a", "06b", "07", "08"],
          "properties": {
            "00": {"$ref": "#/$defs/source_00"},
            "01": {"$ref": "#/$defs/source_designed"},
            "02": {"$ref": "#/$defs/source_designed"},
            "03": {"$ref": "#/$defs/source_03"},
            "04": {"$ref": "#/$defs/source_04"},
            "05": {"$ref": "#/$defs/source_05"},
            "06a": {"$ref": "#/$defs/source_designed"},
            "06b": {"$ref": "#/$defs/source_fallback"},
            "07": {"$ref": "#/$defs/source_07"},
            "08": {"$ref": "#/$defs/source_designed"}
          }
        },
        "workspace_isolation": {"const": "darwin-uf-immutable-v1"},
        "generated_artifacts": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            {"$ref": "#/$defs/clip_00"},
            {"$ref": "#/$defs/clip_01"},
            {"$ref": "#/$defs/clip_02"},
            {"$ref": "#/$defs/clip_03"},
            {"$ref": "#/$defs/clip_04"},
            {"$ref": "#/$defs/clip_05"},
            {"$ref": "#/$defs/clip_06a"},
            {"$ref": "#/$defs/clip_06b"},
            {"$ref": "#/$defs/clip_07"},
            {"$ref": "#/$defs/clip_08"},
            {"$ref": "#/$defs/generated_picture"},
            {"$ref": "#/$defs/generated_audio"},
            {"$ref": "#/$defs/generated_vo_master"}
          ],
          "items": false
        }
      }
    },
    "source_files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "generation_evidence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "media_masters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "external_uri", "files"],
      "properties": {
        "included": {"type": "boolean"},
        "external_uri": {"type": ["string", "null"]},
        "files": {"type": "array", "items": {"$ref": "#/$defs/master"}}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/output"}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "executable",
        "platform",
        "ffmpeg",
        "ffprobe",
        "packages",
        "uv_lock_sha256",
        "fonts",
        "playwright",
        "chromium",
        "playwright_note",
        "worker_mode",
        "code_root",
        "capsule_manifest_sha256"
      ],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "executable": {"type": "string", "pattern": "^/"},
        "platform": {"type": "string", "minLength": 1},
        "ffmpeg": {"type": "string", "minLength": 1},
        "ffprobe": {"type": "string", "minLength": 1},
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matplotlib", "numpy", "pillow", "scipy", "xarray"],
          "properties": {
            "matplotlib": {"type": "string", "minLength": 1},
            "numpy": {"type": "string", "minLength": 1},
            "pillow": {"type": "string", "minLength": 1},
            "scipy": {"type": "string", "minLength": 1},
            "xarray": {"type": "string", "minLength": 1}
          }
        },
        "uv_lock_sha256": {"$ref": "#/$defs/sha256"},
        "fonts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/file"}},
        "playwright": {"const": null},
        "chromium": {"const": null},
        "playwright_note": {"const": "not used by strict public beats 05/07"},
        "worker_mode": {"const": true},
        "code_root": {"const": "sealed-execution-capsule"},
        "capsule_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automated_all_passed",
        "automated",
        "replay",
        "acceptance_frames",
        "human_playback"
      ],
      "properties": {
        "automated_all_passed": {"const": true},
        "automated": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {"$ref": "#/$defs/qc_0"},
            {"$ref": "#/$defs/qc_1"},
            {"$ref": "#/$defs/qc_2"},
            {"$ref": "#/$defs/qc_3"},
            {"$ref": "#/$defs/qc_4"},
            {"$ref": "#/$defs/qc_5"}
          ],
          "items": false
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifacts", "vo_segments", "measurements"],
          "properties": {
            "artifacts": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {"$ref": "#/$defs/replay_picture"},
                {"$ref": "#/$defs/replay_vo_master"}
              ],
              "items": false
            },
            "vo_segments": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "prefixItems": [
                {"$ref": "#/$defs/vo_00_title"},
                {"$ref": "#/$defs/vo_01_hook"},
                {"$ref": "#/$defs/vo_02_stakes"},
                {"$ref": "#/$defs/vo_03_data"},
                {"$ref": "#/$defs/vo_04_ablation"},
                {"$ref": "#/$defs/vo_05_livemap"},
                {"$ref": "#/$defs/vo_06_validation"},
                {"$ref": "#/$defs/vo_07_amd"},
                {"$ref": "#/$defs/vo_08_close"}
              ],
              "items": false
            },
            "measurements": {"$ref": "#/$defs/qc_measurements"}
          }
        },
        "acceptance_frames": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {"$ref": "#/$defs/frame"}
        },
        "human_playback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewed_at_utc", "reviewer", "notes"],
          "properties": {
            "status": {"const": "pending"},
            "reviewed_at_utc": {"const": null},
            "reviewer": {"const": null},
            "notes": {"const": null}
          }
        }
      }
    },
    "rights": {"$ref": "#/$defs/rights"}
  },
  "$defs": {
    "exact_tag": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"enum": ["HEAD", "FETCH_HEAD", "ORIG_HEAD"]},
          {"pattern": "^refs/"}
        ]
      }
    },
    "sha256": {"type": "string", "pattern": "^(?!0{64})[0-9a-f]{64}$"},
    "beat_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "asset_path", "asset_sha256"],
      "properties": {
        "tier": {"type": "string", "minLength": 1},
        "asset_path": {"type": ["string", "null"]},
        "asset_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "source_designed": {
      "allOf": [
        {"$ref": "#/$defs/beat_source"},
        {
          "properties": {
            "tier": {"const": "designed"},
            "asset_path": {"const": null},
            "asset_sha256": {"const": null}
          }
        }
      ]
    },
    "source_fallback": {
      "allOf": [
        {"$ref": "#/$defs/beat_source"},
        {
          "properties": {
            "tier": {"const": "fallback"},
            "asset_path": {"const": null},
            "asset_sha256": {"const": null}
          }
        }
      ]
    },
    "source_00": {
      "allOf": [
        {"$ref": "#/$defs/beat_source"},
        {
          "properties": {
            "tier": {"const": "designed"},
            "asset_path": {"const": "video/build/motif.mp4"},
            "asset_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "source_03_upgrade": {
      "allOf": [
        {"$ref": "#/$defs/beat_source"},
        {
          "properties": {
            "tier": {"const": "upgrade"},
            "asset_path": {"const": "video/build/v2/upgrades/03.mp4"},
            "asset_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "source_03": {
      "oneOf": [
        {"$ref": "#/$defs/source_fallback"},
        {"$ref": "#/$defs/source_03_upgrade"}
      ]
    },
    "source_04_upgrade": {
      "allOf": [
        {"$ref": "#/$defs/beat_source"},
        {
          "properties": {
            "tier": {"const": "upgrade"},
            "asset_path": {"const": "video/build/v2/upgrades/04.mp4"},
            "asset_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "source_04": {
      "oneOf": [
        {"$ref": "#/$defs/source_fallback"},
        {"$ref": "#/$defs/source_04_upgrade"}
      ]
    },
    "source_05": {
      "allOf": [
        {"$ref": "#/$defs/beat_source"},
        {
          "properties": {
            "tier": {"const": "tanager-still"},
            "asset_path": {"const": "video/build/v2/fallback_05.png"},
            "asset_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "source_07": {
      "allOf": [
        {"$ref": "#/$defs/beat_source"},
        {
          "properties": {
            "tier": {"const": "tanager-still"},
            "asset_path": {"const": "video/build/v2/fallback_07.png"},
            "asset_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size_bytes"],
      "properties": {
        "kind": {"enum": ["tts", "music", "doi", "zenodo_record"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "role", "path", "sha256", "size_bytes"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes"],
      "properties": {
        "role": {"enum": ["video", "captions"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path", "sha256", "size_bytes"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^qc/.+\\.png$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "generated_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id", "tier", "sha256", "size_bytes"],
      "properties": {
        "role": {"const": "clip"},
        "id": {"type": "string", "minLength": 1},
        "tier": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "clip_00": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "00"}, "tier": {"const": "designed"}}}
      ]
    },
    "clip_01": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "01"}, "tier": {"const": "designed"}}}
      ]
    },
    "clip_02": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "02"}, "tier": {"const": "designed"}}}
      ]
    },
    "clip_03": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "03"}, "tier": {"enum": ["upgrade", "fallback"]}}}
      ]
    },
    "clip_03_upgrade": {
      "allOf": [
        {"$ref": "#/$defs/clip_03"},
        {"properties": {"tier": {"const": "upgrade"}}}
      ]
    },
    "clip_03_fallback": {
      "allOf": [
        {"$ref": "#/$defs/clip_03"},
        {"properties": {"tier": {"const": "fallback"}}}
      ]
    },
    "clip_04": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "04"}, "tier": {"enum": ["upgrade", "fallback"]}}}
      ]
    },
    "clip_04_upgrade": {
      "allOf": [
        {"$ref": "#/$defs/clip_04"},
        {"properties": {"tier": {"const": "upgrade"}}}
      ]
    },
    "clip_04_fallback": {
      "allOf": [
        {"$ref": "#/$defs/clip_04"},
        {"properties": {"tier": {"const": "fallback"}}}
      ]
    },
    "clip_05": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "05"}, "tier": {"const": "tanager-still"}}}
      ]
    },
    "clip_06a": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "06a"}, "tier": {"const": "designed"}}}
      ]
    },
    "clip_06b": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "06b"}, "tier": {"const": "fallback"}}}
      ]
    },
    "clip_07": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "07"}, "tier": {"const": "tanager-still"}}}
      ]
    },
    "clip_08": {
      "allOf": [
        {"$ref": "#/$defs/generated_clip"},
        {"properties": {"id": {"const": "08"}, "tier": {"const": "designed"}}}
      ]
    },
    "generated_nonclip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id", "sha256", "size_bytes"],
      "properties": {
        "role": {"enum": ["assembled_picture", "final_audio", "vo_master"]},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "generated_picture": {
      "allOf": [
        {"$ref": "#/$defs/generated_nonclip"},
        {"properties": {"role": {"const": "assembled_picture"}, "id": {"const": "picture"}}}
      ]
    },
    "generated_audio": {
      "allOf": [
        {"$ref": "#/$defs/generated_nonclip"},
        {"properties": {"role": {"const": "final_audio"}, "id": {"const": "audio"}}}
      ]
    },
    "generated_vo_master": {
      "allOf": [
        {"$ref": "#/$defs/generated_nonclip"},
        {"properties": {"role": {"const": "vo_master"}, "id": {"const": "vo_master"}}}
      ]
    },
    "qc_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "message"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"const": true},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "qc_0": {
      "allOf": [
        {"$ref": "#/$defs/qc_check"},
        {
          "properties": {
            "name": {"const": "WP-ASM total duration == VO length (+/-1 frame)"},
            "message": {
              "const": "replayed bundled picture and VO-master timing against frozen segment timing"
            }
          }
        }
      ]
    },
    "qc_1": {
      "allOf": [
        {"$ref": "#/$defs/qc_check"},
        {
          "properties": {
            "name": {"const": "WP-MUX stream params (1920x1080/30fps/yuv420p)"},
            "message": {"const": "replayed bundled final MP4 stream structure and parameters"}
          }
        }
      ]
    },
    "qc_2": {
      "allOf": [
        {"$ref": "#/$defs/qc_check"},
        {
          "properties": {
            "name": {"const": "WP-MUX loudness (-16 LUFS / -1.5 dBTP)"},
            "message": {"const": "replayed bundled final MP4 loudness and true peak"}
          }
        }
      ]
    },
    "qc_3": {
      "allOf": [
        {"$ref": "#/$defs/qc_check"},
        {
          "properties": {
            "name": {"const": "WP-MUX A/V equal length"},
